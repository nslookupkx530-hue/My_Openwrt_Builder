#!/bin/bash

# ============================================================
# ImmortalWrt 25.12.x 第三方 APK 插件配置
# ============================================================
#
# 第三方 APK 来源:
# https://github.com/wukongdaily/apk
#
# 支持架构:
#   x86
#   arm64
#   arm64-a53
#
# 工作方式:
#
# 数据流只有一条（不要再往文件里写清单文件，没有脚本读它）：
#   CUSTOM_PACKAGES → shell/apk-prepare-packages.sh → src/packages/*.apk
#                   → 固件 /usr/share/third-party/ → 首启由 apk-install 安装
#
# ------------------------------------------------------------------------------
# 快速索引
#   已启用 : luci-app-store / luci-app-quickstart / luci-i18n-quickstart-zh-cn
#   可启用 : luci-app-run / quickfile / luci-theme-aurora / luci-app-partexp
#            bandix / luci-app-ssr-plus / luci-app-passwall2 / luci-app-rtp2httpd
#            clashoo / luci-app-lucky / daed / luci-app-taskplan / luci-app-mosdns
#   互斥   : quickfile ↔ luci-app-run ； clashoo ↔ nikki
# ------------------------------------------------------------------------------

# ============================================================
# 基础变量
# ============================================================

CUSTOM_PACKAGES=""

# ============================================================
# iStore 商店                                        
# ============================================================
# 说明: iStore 软件中心 + 插件管理
# 依赖: taskd / luci-lib-taskd 等由 APK 安装包及 apk 依赖系统处理，
#       需确认这些依赖也能从 run/<arch>/ 里被取到（构建日志里会列出来）
#
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-store"


# ============================================================
# QuickStart 网络向导                                
# ============================================================
# 说明: 首页向导 + 网络配置引导
# 依赖: iStore（所以 luci-app-store 必须一起启用）
# 注意: 「本体」和「语言包」是两个不同的包
#       · luci-app-quickstart            ← 本体，不装就没有任何菜单
#       · luci-i18n-quickstart-zh-cn     ← 仅中文翻译，装了才有中文
#
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-quickstart"
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-i18n-quickstart-zh-cn"


# ============================================================
# Run 安装器                                          
# ============================================================
# 说明: makeself .run 文件安装器（在路由器上直接跑 .run 安装包）
# 冲突: ⚠ 与 quickfile 的 nginx 配置存在冲突风险，**不要同时开启**
#       quickfile / luci-app-run 二选一
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-run"


# ============================================================
# QuickFile 文件管理器                                
# ============================================================
# 说明: 文件管理器，可在 LuCI 里浏览 / 上传 / 编辑文件
# 来源: github.com/sbwml
# 依赖: bash —— 这是官方 feed 包，不要写进 CUSTOM_PACKAGES
#       （写了会因第三方仓库里没有而 FAIL，让设备端 apk 自己拉即可）
# 冲突: ⚠ 与 luci-app-run 冲突，二选一
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES quickfile luci-app-quickfile luci-i18n-quickfile-zh-cn"


# ============================================================
# Aurora 极光主题                                     
# ============================================================
# 说明: LuCI 主题 + 主题配置页
# 来源: github.com/eamonxg
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-theme-aurora luci-app-aurora-config luci-i18n-aurora-config-zh-cn"


# ============================================================
# Argon 主题  （与 plugins.cfg 二选一）
# ============================================================
# 说明: 经典 Argon 主题（仓库里看到的是 25-argon-2.4.3_x86_64.run，对应
#       luci-theme-argon / luci-app-argon-config，具体包名以构建日志为准）
# 注意: 官方插件开关里也有一个 ENABLE_ARGON（configs/plugins.cfg，走 feeds 编译）
#       ⚠ 两处只能开一处，同时开会有两套主题包打架
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-theme-argon luci-app-argon-config luci-i18n-argon-config-zh-cn"


# ============================================================
# 分区扩容                                            
# ============================================================
# 说明: 在线调整分区 / 扩容 overlay
# 来源: sirpdboy
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-partexp luci-i18n-partexp-zh-cn"


# ============================================================
# Bandix 流量监控                                     
# ============================================================
# 说明: 实时流量统计 / 每设备用量
# 来源: timsaya
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES bandix luci-app-bandix luci-i18n-bandix-zh-cn"


# ============================================================
# SSR Plus                                            
# ============================================================
# 说明: 代理客户端（ssr / v2ray 等）
# 注意: 需先确认 APK 仓库里存在对应架构的软件包
#       kmod-nft-socket / kmod-nft-tproxy 属内核模块，请改在 .config 里选，
#       不要写在这里（见文件头第 2 条）
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES xray-core naiveproxy luci-app-ssr-plus luci-i18n-ssr-plus-zh-cn"


# ============================================================
# PassWall2                                           
# ============================================================
# 说明: 代理客户端（xray / sing-box / hysteria 等内核）
# 注意: 需先确认 APK 仓库里存在对应架构的软件包
#       kmod-nft-socket / kmod-nft-tproxy 同上，请走 .config
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES geoview xray-core sing-box hysteria luci-app-passwall2 luci-i18n-passwall2-zh-cn"


# ============================================================
# IPTV (rtp2httpd)                                    
# ============================================================
# 说明: 把 IPTV 组播流转成 HTTP 单播，方便局域网播放
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-rtp2httpd luci-i18n-rtp2httpd-zh-cn"


# ============================================================
# Clashoo                                            
# ============================================================
# 说明: Clash 内核 + LuCI 面板
# 来源: kenzok8
# 冲突: ⚠ clashoo 与 nikki 配置冲突，**不要同时启用**
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES clashoo luci-app-clashoo luci-i18n-clashoo-zh-cn"


# ============================================================
# Lucky                                              
# ============================================================
# 说明: 内网穿透 / 反向代理 / 动态域名等一体化工具
# 来源: gdy666 / sirpdboy
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-lucky lucky luci-i18n-lucky-zh-cn"


# ============================================================
# Daed                                                
# ============================================================
# 说明: 基于 eBPF 的透明代理（Daed 面板）
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-i18n-daed-zh-cn"


# ============================================================
# TaskPlan                                            
# ============================================================
# 说明: 任务计划（定时脚本 / 定时重启等）
# 来源: sirpdboy
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-taskplan luci-i18n-taskplan-zh-cn"


# ============================================================
# MosDNS                                              
# ============================================================
# 说明: DNS 分流 / 防污染解析器（仓库里看到的是 25-mosdns_v5.3.4-r5_x86_64.run）
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-mosdns luci-i18n-mosdns-zh-cn"


# ============================================================
# 输出（给 CI 日志看，必须保留）
# ============================================================
CUSTOM_PACKAGES="$(printf '%s' "${CUSTOM_PACKAGES}" | xargs)"
echo ">>> third-party packages:${CUSTOM_PACKAGES:- <none>}"
