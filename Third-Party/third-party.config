#!/bin/bash

# ============================================================
# ImmortalWrt 25.12.x 第三方 APK 插件配置
# ============================================================
#
# 第三方 APK 来源:
# https://github.com/wukongdaily/apk
#
# 支持架构:
#   x86
#   arm64
#   arm64-a53
#
# 工作方式:
#
# CUSTOM_PACKAGES
#        ↓
# Prepare third-party APK packages
#        ↓
# 解包 .run 安装包
#        ↓
# 收集 .apk 文件
#        ↓
# 复制到固件:
#   /usr/share/third-party/
#        ↓
# 首次启动后由独立服务安装
#
# 注意:
#
# 1. 这些插件不是 OpenWrt feeds 编译
# 2. 不会进入 make menuconfig
# 3. 不会修改 .config
# 4. 不使用 uci-defaults 安装
# 5. 固件首次启动后由 apk-install 服务安装
#
# ============================================================


# ============================================================
# 基础变量
# ============================================================

CUSTOM_PACKAGES=""

CUSTOM_SOURCE_PACKAGES=""

CUSTOM_SOURCE_FEEDS=""


# ============================================================
# iStore 商店
# ============================================================

# iStore 软件中心
#
# 提供:
# - iStore 软件中心
# - 插件管理
#
# 相关依赖由 APK 安装包及 apk 依赖系统处理。
#
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-store"


# ============================================================
# QuickStart 网络向导
# ============================================================

# 首页和网络向导
#
# 注意:
# 依赖 iStore
#
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-i18n-quickstart-zh-cn"


# ============================================================
# Run 安装器
# ============================================================

# makeself .run 文件安装器
#
# 注意:
# 与 quickfile 的 nginx 配置存在冲突风险。
#
# 不建议同时开启:
#
# quickfile
# luci-app-run
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-run"


# ============================================================
# QuickFile 文件管理器
# ============================================================

# 文件管理器
# 来源: github.com/sbwml
#
# 依赖:
# - bash
#
#CUSTOM_PACKAGES="$CUSTOM_PACKAGES bash quickfile luci-app-quickfile luci-i18n-quickfile-zh-cn"


# ============================================================
# Aurora 极光主题
