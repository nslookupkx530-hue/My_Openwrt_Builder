#!/bin/sh
# ============================================================
#  99-docker-firewall
#  作用：仅当系统里存在 Docker（dockerd）时，配置 docker 的防火墙
#        zone / forwarding，让容器网段 172.16.0.0/12 的端口能穿过防火墙。
#
#  特点：
#   - 幂等：先删掉旧的 docker zone 与所有引用 docker 的 forwarding，再重建
#   - 全程用 uci 命令建 section（不用 cat >> 追加），避免与 uci 缓存打架
#   - 未检测到 dockerd 时 exit 1 → uci-defaults 会【保留】本脚本，下次开机重试
#     （这样"后装 docker"也能自动补上配置；docker 一直在时才 exit 0 被清理）
# ============================================================

DOCKER_SUBNET='172.16.0.0/12'

log() {
    echo "[docker-fw] $*"
    logger -t docker-fw "$*" 2>/dev/null || true
}

if ! command -v dockerd >/dev/null 2>&1; then
    log "未检测到 Docker，保留脚本，下次开机重试"
    # 若你希望"首启没装 docker 就彻底放弃"（脚本会被删除），把下一行改成 exit 0
    exit 1
fi

log "检测到 Docker，开始配置防火墙（subnet ${DOCKER_SUBNET}）"

# ---------------- 1) 清理旧的 docker 相关配置（保证幂等）----------------
uci -q delete firewall.docker

# 先收集所有 forwarding 索引，再【倒序】删除（正序删会打乱后面的索引号）
IDX_LIST="$(uci show firewall 2>/dev/null | grep '=forwarding' | cut -d'[' -f2 | cut -d']' -f1 | sort -rn)"
for idx in ${IDX_LIST}; do
    src="$(uci -q get "firewall.@forwarding[${idx}].src")"
    dest="$(uci -q get "firewall.@forwarding[${idx}].dest")"
    if [ "${src}" = "docker" ] || [ "${dest}" = "docker" ]; then
        log "  删除 forwarding[${idx}] (src=${src} dest=${dest})"
        uci -q delete "firewall.@forwarding[${idx}]"
    fi
done
uci -q commit firewall

# ---------------- 2) 新建 docker zone ----------------
uci set firewall.docker=zone
uci set firewall.docker.name='docker'
uci set firewall.docker.input='ACCEPT'
uci set firewall.docker.output='ACCEPT'
uci set firewall.docker.forward='ACCEPT'
uci add_list "firewall.docker.subnet=${DOCKER_SUBNET}"

# ---------------- 3) docker 与 lan / wan 互通的 forwarding ----------------
# docker -> lan
uci add firewall forwarding
uci set firewall.@forwarding[-1].src='docker'
uci set firewall.@forwarding[-1].dest='lan'
# docker -> wan
uci add firewall forwarding
uci set firewall.@forwarding[-1].src='docker'
uci set firewall.@forwarding[-1].dest='wan'
# lan -> docker
uci add firewall forwarding
uci set firewall.@forwarding[-1].src='lan'
uci set firewall.@forwarding[-1].dest='docker'

uci commit firewall
log "firewall 配置已更新"

# 立即生效（若防火墙服务已启动；首启阶段未启动也无妨，随后启动会用新配置）
if [ -x /etc/init.d/firewall ]; then
    /etc/init.d/firewall reload >/dev/null 2>&1
fi

# ============================================================
#  与 docker 无关的通用设置 —— 不需要就整段删掉
# ============================================================
# 允许所有网口访问网页终端（ttyd 存在时才处理）
if [ -f /etc/config/ttyd ]; then
    uci -q delete ttyd.@ttyd[0].interface
    log "已放开 ttyd 的网口限制"
fi

# 允许所有网口连接 SSH（清空 Interface 限制）
if [ -f /etc/config/dropbear ]; then
    uci -q set dropbear.@dropbear[0].Interface=''
    log "已放开 dropbear 的网口限制"
fi

uci -q commit

exit 0
