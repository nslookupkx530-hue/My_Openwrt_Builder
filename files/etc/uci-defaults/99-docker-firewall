#!/bin/sh
# ============================================================
#  99-docker-firewall   （uci-defaults，首启执行一次，成功后自动移除）
#
#  作用：装了 Docker 的固件，自动放开 Docker 默认地址池 172.16.0.0/12
#        的转发/访问，避免容器端口不通、容器出不了网。
#
#  进不进固件由构建期决定（ENABLE_DOCKER=1 才打包）；这里再做一次运行时检查兜底。
#
#  幂等：先删掉已有的 docker zone 和所有引用它的 forwarding，再追加新配置，
#        重复执行不会累积重复条目。
# ============================================================

# ---------- 运行时兜底：没装 Docker 就直接退出 ----------
if ! command -v dockerd >/dev/null 2>&1 && [ ! -x /etc/init.d/dockerd ]; then
    logger -t docker-firewall "未检测到 Docker，跳过防火墙配置"
    echo "未检测到 Docker，跳过防火墙配置。"
    exit 0
fi

logger -t docker-firewall "检测到 Docker，开始配置防火墙规则"
echo "检测到 Docker，正在配置防火墙规则..."

FW_FILE="/etc/config/firewall"
[ -f "$FW_FILE" ] || { logger -t docker-firewall "找不到 $FW_FILE"; exit 1; }

# ---------- 1) 删掉旧的 docker zone ----------
uci -q delete firewall.docker 2>/dev/null || true

# ---------- 2) 删掉所有 src/dest 指向 docker 的 forwarding ----------
#   必须"倒序"删：删掉一个索引后后面的会前移，正序会漏删/删错
#   只取匿名段（firewall.@forwarding[N]=forwarding）的数字索引，
#   避免命名段被拼成非法索引
for idx in $(uci show firewall | grep '=forwarding' \
             | sed -n 's/^firewall\.@forwarding\[\([0-9]\+\)\]=forwarding$/\1/p' \
             | sort -rn); do
    src="$(uci -q get "firewall.@forwarding[$idx].src" 2>/dev/null)"
    dest="$(uci -q get "firewall.@forwarding[$idx].dest" 2>/dev/null)"
    if [ "$src" = "docker" ] || [ "$dest" = "docker" ]; then
        logger -t docker-firewall "删除 forwarding[$idx] (src=$src dest=$dest)"
        uci -q delete "firewall.@forwarding[$idx]"
    fi
done

# 提交删除；失败就退出 1 —— uci-defaults 会把脚本留到下次开机重试
if ! uci commit firewall; then
    logger -t docker-firewall "uci commit firewall 失败，下次开机重试"
    exit 1
fi

# ---------- 3) 追加新配置 ----------
#   开头故意留一个空行：即使原文件末尾没有换行，也不会把新内容粘到最后一行上
#   故意不写 option device 'docker0'：首启时 docker0 可能还没被 dockerd 创建，
#   只按 subnet 匹配更稳（写了 device 反而可能让 fw4 报 device 不存在的警告）
cat <<'EOF' >>"$FW_FILE"

config zone 'docker'
	option name 'docker'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	list subnet '172.16.0.0/12'

config forwarding
	option src 'docker'
	option dest 'lan'

config forwarding
	option src 'docker'
	option dest 'wan'

config forwarding
	option src 'lan'
	option dest 'docker'
EOF

# ---------- 4) 校验：让 uci 重新解析一遍，确认追加的内容合法 ----------
if ! uci -q get firewall.docker.name >/dev/null 2>&1; then
    logger -t docker-firewall "追加配置后 uci 解析异常，下次开机重试"
    exit 1
fi

# ---------- 5) 立即生效 ----------
#   本脚本在 uci-defaults 阶段执行，正常会早于 /etc/init.d/firewall 的启动，
#   所以通常不需要重启；这里仍重启一次，保证任何启动顺序下都立即生效。
if [ -x /etc/init.d/firewall ]; then
    /etc/init.d/firewall restart >/dev/null 2>&1 \
        || logger -t docker-firewall "firewall restart 失败（不影响配置写入）"
fi

logger -t docker-firewall "Docker 防火墙规则配置完成"
echo "Docker 防火墙规则配置完成。"
exit 0
