#!/bin/sh
# ============================================================
#  98-drop-kmods-repo
#
#  目的：distfeeds.list 里的 /kmods/ 源，内核版本必须与设备实际运行内核一致，
#        否则 apk update 会因 404 **整体失败**（一个源失败 = 整个事务失败）。
#
#  策略：版本一致 → 保留（这样才能装官方/镜像的 kmod-* 包）
#        版本不一致 → 删掉这一个源
#
#  实测：官方 25.12.2 的 kmods 目录 = 6.12.103-1-0413601b1c3f0490e17f340fe09229ea
#        设备 uname -r = 6.12.103  → 一致 → 该源会保留并可用
#
#  幂等，只在首次启动（uci-defaults）跑一次；始终 exit 0 防止反复重试。
# ============================================================

LIST="/etc/apk/repositories.d/distfeeds.list"

[ -f "$LIST" ] || exit 0

KERNEL="$(uname -r)"            # 例如 6.12.103
[ -n "$KERNEL" ] || exit 0

TMP="$(mktemp)" || exit 0
cp "$LIST" "$TMP"
REMOVED=0

# 删除 TMP 中完全等于 $1 的那一行；保证不会把文件清空
drop_line() {
    grep -vxF "$1" "$TMP" > "${TMP}.new" 2>/dev/null || true
    if [ -s "${TMP}.new" ]; then
        mv "${TMP}.new" "$TMP"
        return 0
    fi
    logger -t drop-kmods-repo "跳过删除（会导致 distfeeds 为空）: $1"
    rm -f "${TMP}.new" 2>/dev/null || true
    return 1
}

# ---------- 私有 feed 死链清理 ----------
# 构建时 include/feeds.mk 会给每个 feed 生成一条 distfeeds 行（URL 一律拼成
# "官方下载站 + feed 名"），但私有 feed（m0eakpatch / fanchmwrt …）并不在
# downloads.openwrt.org 上 → 这类行必然 404，而一个 404 源会让 apk update
# 整体失败，必须删掉。
# 做法：确定性删除，不做网络探测（首启可能还没网，探测会把正常源也删掉）。
# 以后每新增一个私有 feed，把名字补进下面这个用 | 分隔的列表即可。
# 静态：私有 feed（不在任何官方下载站上，必然死链）
PRIVATE_FEEDS="m0eakpatch|fanchmwrt"

# 基线特例：<宿主关键字>:<feed 名>
#   实测 immortalwrt 25.12-SNAPSHOT 没有 video feed（downloads.immortalwrt.org 上 404），
#   而 openwrt 基线的 video 是好的 → 所以必须带宿主条件，不能塞进 PRIVATE_FEEDS
DEAD_BY_HOST="downloads.immortalwrt.org:video"

# 预留：构建期探活结果（暂时留空）
DEAD_FEEDS=""

HOST="$(grep -m1 -oE 'https?://[^/]+' "$TMP" 2>/dev/null | sed -E 's|^https?://||')"
PAT="${PRIVATE_FEEDS}"
for entry in ${DEAD_BY_HOST}; do
    h="${entry%%:*}"; f="${entry##*:}"
    case "${HOST}" in *"${h}"*) PAT="${PAT}|${f}" ;; esac
done
[ -n "${DEAD_FEEDS}" ] && PAT="${PAT}|$(printf '%s' "${DEAD_FEEDS}" | tr ' ' '|')"
logger -t drop-kmods-repo "baseline=${HOST:-未知} 生效删除名单=${PAT}"

if grep -qE "/(${PAT})/packages\.adb$" "$TMP" 2>/dev/null; then
    grep -vE "/(${PAT})/packages\.adb$" "$TMP" > "${TMP}.priv" 2>/dev/null || true
    if [ -s "${TMP}.priv" ]; then
        mv "${TMP}.priv" "$TMP"
        REMOVED=$((REMOVED + 1))
        logger -t drop-kmods-repo "已删除私有 feed 死链源 (${PAT})"
    else
        logger -t drop-kmods-repo "私有 feed 清理异常，保持原样"
    fi
    rm -f "${TMP}.priv" 2>/dev/null || true
fi

# ---------- kmods 源内核版本核对 ----------
while IFS= read -r line; do
    case "$line" in
        *"/kmods/"*) ;;
        *) continue ;;
    esac

    dir="${line#*/kmods/}"      # 6.12.103-1-0413601b.../packages.adb
    dir="${dir%%/*}"            # 6.12.103-1-0413601b...
    ver="${dir%%-*}"            # 6.12.103

    if [ "$ver" = "$KERNEL" ]; then
        logger -t drop-kmods-repo "kmods 源内核匹配 (${ver})，保留"
        continue
    fi

    logger -t drop-kmods-repo "kmods 源内核不匹配 (${ver} != ${KERNEL})，删除该源"
    if drop_line "$line"; then REMOVED=$((REMOVED + 1)); fi
done < "$LIST"

# ---------- 写回 ----------
if [ "$REMOVED" -gt 0 ]; then
    cp "$TMP" "$LIST"
    rm -f /var/lock/apk* 2>/dev/null || true
    logger -t drop-kmods-repo "已清理 ${REMOVED} 处源（kmods 版本不匹配 / 私有 feed 死链）"
fi

rm -f "$TMP" "${TMP}.new" "${TMP}.priv" 2>/dev/null || true
exit 0
