#     log "检测到 <包名>，修正配置"
#
#     uci set <配置节>.<选项>='<值>'
#
#     uci -q delete <配置节>.<列表选项>          # 列表项：先删
#     uci add_list <配置节>.<列表选项>='<值1>'   # 再加（保证可重跑）
#     uci add_list <配置节>.<列表选项>='<值2>'
#
#     if uci commit <配置名>; then
#         log "<包名> 配置已修正"
#         svc_restart <服务名>                   # 需要才写
#     else
#         log "ERROR: uci commit <配置名> 失败"
#         RC=1
#     fi
# else
#     log "未检测到 <包名>，跳过"
# fi

# ==================================================================
if [ "${RC}" = "0" ]; then
    log "第三方包配置修正完成"
else
    log "有配置提交失败，脚本保留，下次开机重试"
fi
exit "${RC}"
