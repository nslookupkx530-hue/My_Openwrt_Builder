#!/bin/sh /etc/rc.common

START=99
STOP=10

SCRIPT=""

find_script() {
    for p in /etc/third-party/install_third_party_apk.sh \
             /etc/ithird-party/install_third_party_apk.sh; do
        if [ -f "$p" ]; then
            SCRIPT="$p"
            return 0
        fi
    done
    return 1
}

start() {
    if ! find_script; then
        logger -t third-party "找不到 install_third_party_apk.sh，跳过"
        return 0
    fi
    logger -t third-party "计划安装第三方 apk: ${SCRIPT}"
    (
        # 等 network / uci-defaults 就绪；脚本内部还有网络重试兜底
        sleep 10
        /bin/sh "$SCRIPT"
    ) >/tmp/third-party-apk.out 2>&1 &
}

boot()    { start; }
stop()    { :; }
restart() { start; }
