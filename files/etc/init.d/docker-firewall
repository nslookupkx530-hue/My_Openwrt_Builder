#!/bin/sh /etc/rc.common
# ============================================================
#  /etc/init.d/docker-firewall
#
#  作用：在 dockerd 启动【之后】补齐 docker 相关的 fw4 forwarding，
#        让「局域网设备访问容器发布的端口」这条路通。
#
#  为什么是 init.d + START=99，而不是 uci-defaults：
#    · docker zone（/etc/config/firewall 里的 docker）由 dockerd 包创建，
#      只可能在 dockerd 起来之后才存在（实际是在 /etc/init.d/dockerd 的 boot() 段创建的）；
#    · uci-defaults 跑在首启很早的阶段（那时 docker 还没起来/还没装），
#      在那里加 forwarding 引用不到 zone，等于白写；
#    · 所以必须排在 dockerd 之后（S99）。
#
#  ⚠ 时序注意（实测踩过）：S99docker-firewall 与 S99dockerd 同为 99，
#    字母序 '-' < 'd' → 本脚本【先】跑，那一刻 zone 必然还不存在。
#    且 rcS 是顺序执行的：同步阻塞等待会把 dockerd 自己挡在后面，
#    导致永远等不到 zone（还会白拖 60s 开机）。
#    所以 start() 必须立刻返回，由 docker_fix_async 在后台轮询补规则。
#
#  铁律（踩过的坑）：
#    ✗ 不自己写 config zone 'docker'
#        —— 包的 zone 带 network='docker' / blocked_interfaces 等关键语义，
#           我们写个同名 zone 会让包跳过创建（丢语义）或被包覆盖（白写）；
#    ✗ 不 uci delete firewall.docker
#        —— 删掉的是包的 zone；
#    ✓ 只做「缺了就补」，幂等，每次开机跑一遍也无副作用。
#
#  容器 -> WAN 由 dockerd 包的 blocked_interfaces 控制，本脚本【不碰】：
#      uci del_list dockerd.firewall.blocked_interfaces='wan'
#      uci commit dockerd && /etc/init.d/dockerd restart
# ============================================================
START=99
STOP=10

LOG_TAG="docker-firewall"

log() {
    logger -t "$LOG_TAG" "$*"
    echo "[$LOG_TAG] $*"
}

# ---------- 后台轮询：等 docker zone 出现后补 forwarding（不阻塞开机、不建不删 zone） ----------
docker_fix_async() {
    i=0
    while [ "$i" -lt 60 ]; do                 # 60 × 5s = 5 分钟
        if uci -q get firewall.docker >/dev/null 2>&1; then
            add_forwarding lan docker         # 局域网设备 -> 容器（访问容器发布的端口）
            add_forwarding docker lan         # 容器 -> 局域网设备
            add_forwarding docker wan         # 容器 -> 外网（wan 区域 forward=REJECT，必须显式放行）  ← 新增
            uci commit firewall
            fix_forward_policy
            if command -v fw4 >/dev/null 2>&1; then
                fw4 reload >/dev/null 2>&1 && log "fw4 reload 完成" || log "fw4 reload 失败（配置已写入，可手动执行 fw4 reload）"
            else
                /etc/init.d/firewall reload >/dev/null 2>&1 || log "firewall reload 失败（配置已写入）"
            fi
            log "docker-firewall 应用完成（docker zone 已就绪）"
            return 0
        fi
        sleep 5
        i=$((i+1))
    done
    log "5 分钟内仍未出现 docker zone（首启还没跑过 dockerd 的 boot 初始化？），下次开机会再试"
    return 0
}

# ---------- forwarding 查询 / 添加 ----------
has_forwarding() {   # $1=src $2=dest
    local idx s d
    for idx in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.@forwarding\[\([0-9][0-9]*\)\]=forwarding$/\1/p'); do
        s="$(uci -q get "firewall.@forwarding[$idx].src")"
        d="$(uci -q get "firewall.@forwarding[$idx].dest")"
        if [ "$s" = "$1" ] && [ "$d" = "$2" ]; then
            return 0
        fi
    done
    return 1
}

add_forwarding() {   # $1=src $2=dest
    if has_forwarding "$1" "$2"; then
        log "forwarding $1 -> $2 已存在，跳过"
        return 0
    fi
    uci add firewall forwarding >/dev/null 2>&1
    uci set "firewall.@forwarding[-1].src=$1"
    uci set "firewall.@forwarding[-1].dest=$2"
    log "已添加 forwarding: $1 -> $2"
    return 0
}

# ---------- 兜底：docker 若把 iptables 的 FORWARD 默认策略改成 DROP，改回来 ----------
#   正常本来就该是 ACCEPT，只有真被改成 DROP 时才动，避免干扰别人的策略设置
fix_forward_policy() {
    command -v iptables >/dev/null 2>&1 || return 0
    pol="$(iptables -L FORWARD -n 2>/dev/null | sed -n '1s/.*policy \([A-Z]*\).*/\1/p')"
    if [ "$pol" = "DROP" ]; then
        if iptables -P FORWARD ACCEPT 2>/dev/null; then
            log "检测到 FORWARD 默认策略为 DROP（docker 所致），已改回 ACCEPT"
        else
            log "FORWARD 策略为 DROP，改回失败（可手动执行 iptables -P FORWARD ACCEPT）"
        fi
    fi
    return 0
}

start() {
    log "docker-firewall start：后台等待 docker zone（不阻塞开机）"
    docker_fix_async >/dev/null 2>&1 </dev/null &
    return 0
}

stop() { :; }
