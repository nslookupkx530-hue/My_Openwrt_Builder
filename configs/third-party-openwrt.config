# =============================================================================
# 第三方预编译包清单（A 线 openwrt 源 + DSF 线 GL-MT5000 共用）
#   * A 线：SOURCE_TYPE=openwrt 时，由 shell/fetch-openwrt-third-party.sh 读取
#   * DSF ：shell/DSF/fetch-openwrt-third-party.sh 读取（TP_APK_DEVICES 门控）
#   * 格式: <完整包名>=<apk 仓库 openwrt/<arch>/ 下的子目录>
#   * 二进制来源: immortalwrt 25.12.2 的 packages/<arch>/luci/
#     详见 apk 仓库 openwrt/<arch>/luci-third-party-openwrt/SOURCE.txt
#   * 这些包 openwrt 上游根本没有，只能走二进制旁路，不参与源码编译
# =============================================================================

# ---- argon 主题（A 线 / DSF 统一用这个）----
luci-theme-argon=luci-third-party-openwrt
luci-app-argon-config=luci-third-party-openwrt
luci-i18n-argon-config-zh-cn=luci-third-party-openwrt

# ---- diskman 磁盘管理 ----
luci-app-diskman=luci-third-party-openwrt
luci-i18n-diskman-zh-cn=luci-third-party-openwrt

# ---- autoreboot 定时重启 ----
luci-app-autoreboot=luci-third-party-openwrt
luci-i18n-autoreboot-zh-cn=luci-third-party-openwrt

# ---- ramfree 内存释放 ----
luci-app-ramfree=luci-third-party-openwrt
luci-i18n-ramfree-zh-cn=luci-third-party-openwrt

# ---- filebrowser-go 依赖的二进制包（来自 packages feed，openwrt 上游没有）----
filebrowser=luci-third-party-openwrt

# ---- filebrowser-go 文件管理 ----
luci-app-filebrowser-go=luci-third-party-openwrt
luci-i18n-filebrowser-go-zh-cn=luci-third-party-openwrt

# ---- tcping（可选）----
#   加之前必须先确认 A 线仓库 openwrt/x86_64/luci-third-party-openwrt/ 里也有 tcping-*.apk，
#   否则 A 线 openwrt 构建会 die。不加则 MT5000 没有 tcping。
# tcping=luci-third-party-openwrt
