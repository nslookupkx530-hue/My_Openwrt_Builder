# =============================================================================
# openwrt 源专用第三方预编译包清单
#   * 仅当 SOURCE_TYPE=openwrt 时，由 shell/fetch-openwrt-third-party.sh 读取
#   * 格式: <完整包名>=<apk 仓库 run/<arch>/ 下的子目录>
#   * 二进制来源: immortalwrt 25.12.2  packages/x86_64/luci/
#     详见 apk 仓库 run/x86_64/luci-third-party-openwrt/SOURCE.txt
#   * 这些包 openwrt 上游根本没有，只能走二进制旁路，不参与源码编译
#     —— 那三个由 shell/inject_plugins.sh 写进 .config 后编译，见文件 ④
# =============================================================================

# ---- argon 主题 ----
luci-theme-argon=luci-third-party-openwrt
luci-app-argon-config=luci-third-party-openwrt
luci-i18n-argon-config-zh-cn=luci-third-party-openwrt

# ---- diskman 磁盘管理 ----
luci-app-diskman=luci-third-party-openwrt
luci-i18n-diskman-zh-cn=luci-third-party-openwrt

# ---- autoreboot 定时重启 ----
luci-app-autoreboot=luci-third-party-openwrt
luci-i18n-autoreboot-zh-cn=luci-third-party-openwrt

# ---- ramfree 内存释放 ----
luci-app-ramfree=luci-third-party-openwrt
luci-i18n-ramfree-zh-cn=luci-third-party-openwrt

# ---- filebrowser-go 文件管理 ----
luci-app-filebrowser-go=luci-third-party-openwrt
luci-i18n-filebrowser-go-zh-cn=luci-third-party-openwrt
